APP_NAME="RDockPanel"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate with: rustcms key:generate
APP_KEY=

# MySQL 8.4 from docker-compose.yml (`docker compose up -d`).
DATABASE_URL=mysql://panel:panel@127.0.0.1:3306/panel
# Or SQLite, one file (no server):
# DATABASE_URL=sqlite://storage/panel.sqlite?mode=rwc

# scripts/dev-swarm.sh serves HTTPS on 8443.
RUSTCMS_PANEL__HTTPS_PORT=8443
RUSTCMS_PANEL__SERVICE_DOMAIN=localhost
